# frontend/.env.example — proctor-web build-time configuration
#
# For LOCAL development, copy to frontend/.env.local (gitignored) and fill in:
#   cp frontend/.env.example frontend/.env.local
#
# For PRODUCTION, do NOT set these by hand — frontend/deploy-gcp.sh derives the
# hashed values from ADMIN_PASSWORD / INVIGILATOR_PASSWORD and bakes them into the
# bundle, then verifies they are present before deploying. Plain passwords are
# never shipped in the production bundle. Every value below is a PLACEHOLDER.

# ── Fastest path: offline demo (no backend, no GCP) ────────────────────────
# true => the whole UI runs on a localStorage fake. Admin unlock uses the plain
# VITE_ADMIN_PASSWORD below (demo/local only — never set this in production).
VITE_DEMO_MODE=true
VITE_ADMIN_PASSWORD=dev
# Plain invigilator-portal password for the /invigilator gate (demo/local only —
# never set this in production; deploy bakes VITE_INVIGILATOR_PASSWORD_HASH instead).
VITE_INVIGILATOR_PASSWORD=dev

# ── Against a real backend ─────────────────────────────────────────────────
# Base URL of the deployed/local proctor-api the app should call.
VITE_API_BASE_URL=http://localhost:8080

# Optional: separate proctor-eval service URL backing the Evaluation tab's
# embedded /eval-ui. Unset => the eval tab is served from VITE_API_BASE_URL
# (same-origin). Set this when proctor-eval is deployed as its own service.
# VITE_EVAL_API_URL=https://your-proctor-eval-url

# ── Production only (set by frontend/deploy-gcp.sh — do not hand-edit) ──────
# sha256(ADMIN_PASSWORD); the admin unlock gate hashes the typed password to match.
# VITE_ADMIN_PASSWORD_HASH=
# sha256(INVIGILATOR_PASSWORD); the invigilator gate hashes the typed value to match.
# VITE_INVIGILATOR_PASSWORD_HASH=
