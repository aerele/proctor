{
  "name": "aerele-proctor",
  "private": true,
  "version": "0.1.0",
  "description": "Aerele Proctor — a self-hosted own-editor coding-exam platform: live screen + camera proctoring, Judge0 Run/Submit, and a calibrated integrity + talent hire-recommendation evaluation.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
