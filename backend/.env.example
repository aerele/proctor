# backend/.env.example — proctor-api / proctor-eval runtime configuration
#
# Copy to a local, gitignored file before filling real values:
#   cp backend/.env.example backend/.env   # (backend/.env is gitignored)
#
# In production these are set on the Cloud Run service by backend/deploy-gcp.sh
# (a subset) and applied manually post-deploy (the rest) — see docs/DEPLOY.md.
# NEVER commit a filled-in copy. Every value below is a PLACEHOLDER.

# ── Required ───────────────────────────────────────────────────────────────
# Secret for all /api/admin/* routes (sent as x-admin-password, timing-safe).
#   openssl rand -base64 24
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# GCS bucket for screen/camera chunks, JSONL event logs, and manifests. Also the
# signing target for alert video_key deep-links. Bucket names are globally unique.
EVIDENCE_BUCKET=your-globally-unique-proctor-evidence-bucket

# ── Code execution: Judge0 (RapidAPI by default) ───────────────────────────
# Default endpoint + auth mode use the public Judge0 CE on RapidAPI. Subscribe at
# https://rapidapi.com/judge0-official/api/judge0-ce and paste the key below.
# To self-host Judge0 instead, set JUDGE0_MODE=selfhosted, point JUDGE0_BASE_URL
# at your instance, and use JUDGE0_AUTH_TOKEN instead of JUDGE0_API_KEY.
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_MODE=rapidapi
JUDGE0_API_KEY=replace-with-your-rapidapi-judge0-key
# JUDGE0_AUTH_TOKEN=replace-with-self-hosted-judge0-x-auth-token

# ── Closed-by-default secrets (unset = that route rejects all calls) ────────
# Shared secret for POST /api/alerts (x-api-key). Unset => ingestion is blocked.
#   openssl rand -base64 32
ALERTS_INGEST_API_KEY=replace-with-a-long-random-ingest-api-key
# Secret for POST /api/admin/retention-sweep (x-api-key; admin password also passes).
RETENTION_SWEEP_API_KEY=replace-with-a-long-random-sweep-api-key
# Global invigilator fallback secret (a contest invigilator_key or the admin
# password also authenticate). Unset => only those two paths work.
INVIGILATOR_PASSWORD=replace-with-a-long-random-invigilator-password

# ── Signing (optional) ─────────────────────────────────────────────────────
# Path to a service-account JSON key used for local v4 signed-URL generation.
# Leave unset to use the runtime's Application Default Credentials / metadata server.
# SIGNER_KEY_FILE=/secrets/signer-key.json

# ── CORS / URLs ────────────────────────────────────────────────────────────
# CORS allow-origin. Keep * for first bring-up; lock to the exact frontend URL
# in production.
PUBLIC_APP_ORIGIN=*
# Frontend URL (optional; used by the bundle-hash preflight probe).
# PUBLIC_APP_URL=https://your-frontend-url

# ── Tuning (safe defaults shown) ───────────────────────────────────────────
URL_EXPIRY_SECONDS=900
DISCONNECTED_STALENESS_MS=45000
EDITOR_EVENTS_INGEST_LIMIT=5000
EXEC_RUN_COOLDOWN_SECONDS=5
EXEC_SUBMIT_COOLDOWN_SECONDS=20
EXEC_MAX_SUBMISSIONS_PER_SESSION=50
EXEC_RUN_CONCURRENCY=2
EXEC_SUBMIT_CONCURRENCY=4
EXEC_POLL_CONCURRENCY=16
EXEC_MAX_QUEUE=200
GATE_ATTEMPT_LIMIT=20

# ── Evaluation (proctor-eval) ──────────────────────────────────────────────
EVALUATE_BATCH_LIMIT=25
EVALUATE_TIME_BUDGET_MS=90000
EVAL_LEASE_MS=180000
# Comma-separated Firestore collections the eval service is allowed to write.
# Empty = no write guard. Set to the evaluations collection name to harden the
# eval deploy so it can only touch evaluation docs.
# EVAL_WRITE_ALLOWLIST=proctor_evaluations

# ── Firestore collection names (all optional; defaults shown) ───────────────
# Override only if you need to share a Firestore project across environments.
# SESSION_COLLECTION=proctor_sessions
# SETTINGS_COLLECTION=proctor_settings
# ALERTS_COLLECTION=proctor_alerts
# SUBMISSION_EVENTS_COLLECTION=proctor_submission_events
# LIVE_LOCK_COLLECTION=proctor_live_locks
# REVIEW_STATE_COLLECTION=proctor_review_state
# REVIEW_COLLECTION=proctor_reviews
# REVIEW_CLAIMS_COLLECTION=proctor_review_claims
# SUBMISSIONS_COLLECTION=proctor_submissions
# RUN_EVENTS_COLLECTION=proctor_run_events
# PROBLEMS_COLLECTION=proctor_problems
# EDITOR_EVENTS_COLLECTION=editor-events
# ROSTER_COLLECTION=proctor_roster
# ROOM_GATES_COLLECTION=proctor_room_gates
# CONTESTS_COLLECTION=proctor_contests
# COLLEGES_COLLECTION=proctor_colleges
# PERSONS_COLLECTION=proctor_persons
# ENROLLMENTS_COLLECTION=proctor_enrollments
# ADMIN_AUDIT_COLLECTION=proctor_admin_audit
# TEMPLATES_COLLECTION=proctor_templates
# EVALUATIONS_COLLECTION=proctor_evaluations
