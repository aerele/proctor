# video-worker/.env.example — OPTIONAL screen-chunk merge service
#
# The video-worker stitches per-session screen chunks into one playable review
# video. It is OPTIONAL and not required to run an exam. Copy to a local,
# gitignored file before filling real values. Every value below is a PLACEHOLDER.

# ── Required ───────────────────────────────────────────────────────────────
# Bearer / x-worker-token secret protecting POST /merge.
#   openssl rand -base64 32
WORKER_TOKEN=replace-with-a-long-random-worker-token

# ── Buckets (defaults derive from PROJECT_ID at deploy time) ───────────────
# GCS bucket holding the screen chunks (usually the same as the backend's
# EVIDENCE_BUCKET).
SOURCE_BUCKET=your-globally-unique-proctor-evidence-bucket
# GCS bucket for the merged review videos + manifests.
DEST_BUCKET=your-globally-unique-proctor-review-video-bucket

# ── Optional ───────────────────────────────────────────────────────────────
# Firestore collection for the merged_video_key write-back. MUST match the
# backend's SESSION_COLLECTION.
SESSION_COLLECTION=proctor_sessions
# Cap on usernames merged in a single /merge request.
MAX_USERNAMES_PER_REQUEST=25
# HTTP port (Cloud Run sets this automatically).
PORT=8080
